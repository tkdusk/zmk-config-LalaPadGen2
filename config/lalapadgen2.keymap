#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <24 23>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <25 26>;
        };

        system_layer {
            bindings = <&mo 3>;
            key-positions = <8 9>;
        };
    };

    macros {
        enter_pass: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>; // ENTER_PASS_PH
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q               &kp W             &kp E              &kp R               &kp T                                 &kp Y           &kp U          &kp I             &kp O               &kp P
&kp A               &kp S             &kp D              &kp F               &kp G                                 &kp H           &kp J          &kp K             &kp L               &mt EQUAL MINUS
&mt LEFT_COMMAND Z  &kp X             &kp C              &kp V               &kp B                                 &kp N           &kp M          &kp COMMA         &kp PERIOD          &kp SLASH
&kp LEFT_SHIFT      &kp LEFT_COMMAND  &kp LEFT_CONTROL   &kp LEFT_ALT        &kp SPACE         &mo 1       &mo 2   &kp ENTER       &kp BACKSPACE  &kp LANGUAGE_2    &kp LANGUAGE_1      &kp INTERNATIONAL_1
                    &kp LA(LC(C))     &kp LA(LC(RIGHT))  &kp LC(DOWN)        &kp LC(LA(LEFT))  &kp LC(UP)  &kp UP  &kp LEFT_ARROW  &kp DOWN       &kp RIGHT         &trans
&mkp LCLK           &mkp RCLK         &mkp MCLK                                                                                                   &mkp LCLK         &mkp RCLK           &mkp MCLK
&mkp MB5            &mkp MB4          &kp LC(UP_ARROW)   &kp LC(DOWN_ARROW)  &none                                 &mkp MB5        &mkp MB4       &kp LC(UP_ARROW)  &kp LC(DOWN_ARROW)  &none
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp LG(W)  &kp LS(LG(T))   &none           &kp RIGHT_ALT    &enter_pass                  &mt LS(N1) N1           &mt LS(N2) N2    &mt LS(N3) N3            &mt LS(N4) N4      &mt N5 LS(N5)
&kp PG_UP  &mkp MB4        &kp UP_ARROW    &mkp MB5         &kp HOME                     &mt LS(N6) N6           &mt LS(N7) N7    &mt LS(N8) N8            &mt LS(N9) N9      &mt LS(N0) N0
&kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END                      &mt LS(SEMI) SEMI       &mt LS(SQT) SQT  &mt LS(RBKT) RBKT        &mt LS(BSLH) BSLH  &mt LS(INT3) INT3
&trans     &trans          &trans          &trans           &trans       &trans  &trans  &studio_unlock          &trans           &trans                   &trans             &mt LS(LBKT) LBKT
           &trans          &trans          &trans           &trans       &trans  &trans  &kp LA(LG(LEFT_ARROW))  &trans           &kp LA(LG(RIGHT_ARROW))  &trans
&trans     &trans          &trans                                                                                                 &trans                   &trans             &trans
&trans     &trans          &trans          &trans           &trans                       &trans                  &trans           &trans                   &trans             &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&none   &kp KP_N7      &kp KP_N8  &kp KP_N9        &kp KP_PLUS                      &kp LG(W)  &kp LS(LG(T))   &none           &kp RIGHT_ALT    &enter_pass
&none   &kp KP_N4      &kp KP_N5  &kp KP_N6        &kp KP_MINUS                     &kp PG_UP  &mkp MB4        &kp UP_ARROW    &mkp MB5         &kp HOME
&none   &kp KP_N1      &kp KP_N2  &kp KP_NUMBER_3  &kp KP_MULTIPLY                  &kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&trans  &kp KP_DOT     &kp KP_N0  &trans           &kp KP_SLASH     &trans  &trans  &trans     &trans          &trans          &trans           &trans
        &kp LC(LA(F))  &trans     &trans           &trans           &trans  &trans  &trans     &trans          &trans          &trans
&trans  &trans         &trans                                                                                  &trans          &trans           &trans
&trans  &trans         &trans     &trans           &trans                           &trans     &trans          &trans          &trans           &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &bootloader                    &bt BT_SEL 0                   &bt BT_SEL 1                   &none                          &none
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bt BT_CLR                     &bt BT_CLR_ALL                 &none                          &none
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
